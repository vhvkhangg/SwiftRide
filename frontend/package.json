{
  "name": "swiftride-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/rider", "apps/driver"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev:rider",
    "dev:rider": "npm run dev --workspace=@swiftride/rider",
    "dev:driver": "npm run dev --workspace=@swiftride/driver",
    "build": "npm run build --workspaces",
    "build:rider": "npm run build --workspace=@swiftride/rider",
    "build:driver": "npm run build --workspace=@swiftride/driver",
    "preview:rider": "npm run preview --workspace=@swiftride/rider",
    "preview:driver": "npm run preview --workspace=@swiftride/driver",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
