{
  "expo": {
    "name": "SwiftRide Rider",
    "slug": "swiftride-rider",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "swiftride-rider",
    "android": {
      "package": "com.swiftride.rider",
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.swiftride.rider",
      "supportsTablet": false
    },
    "plugins": [
      "expo-font"
    ]
  }
}
