{
  "name": "swiftride-mobile",
  "private": true,
  "type": "module",
  "workspaces": ["apps/rider", "apps/driver"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start:rider": "npm run start --workspace=@swiftride/rider",
    "start:driver": "npm run start --workspace=@swiftride/driver",
    "android:rider": "npm run android --workspace=@swiftride/rider",
    "android:driver": "npm run android --workspace=@swiftride/driver",
    "preview:rider": "npm run web --workspace=@swiftride/rider",
    "preview:driver": "npm run web --workspace=@swiftride/driver",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "export:android": "npm run export:android --workspaces"
  },
  "devDependencies": { "typescript": "~6.0.3", "@types/react": "~19.2.2" }
}
