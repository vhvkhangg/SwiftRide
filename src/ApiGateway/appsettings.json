{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://localhost:8180/realms/swiftride",
    "Audience": "swiftride-api",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "trips": {
        "ClusterId": "trip",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/trips/{**catch-all}",
          "Methods": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "trip-hub": {
        "ClusterId": "trip",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/hubs/trips/{**catch-all}",
          "Methods": [
            "GET",
            "POST",
            "DELETE"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "quote": {
        "ClusterId": "matching",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/matching/quote",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathSet": "/quote"
          }
        ]
      },
      "match": {
        "ClusterId": "matching",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/matching/match",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathSet": "/match"
          }
        ]
      },
      "driver-location": {
        "ClusterId": "matching",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/drivers/location",
          "Methods": [
            "POST"
          ]
        }
      },
      "payments": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/payments/{**catch-all}",
          "Methods": [
            "GET",
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      }
    },
    "Clusters": {
      "trip": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "matching": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "payment": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5103/"
          }
        }
      }
    }
  }
}
