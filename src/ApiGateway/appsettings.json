{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "trip-route": {
        "ClusterId": "trip-cluster",
        "Match": {
          "Path": "/api/trips/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "matching-route": {
        "ClusterId": "matching-cluster",
        "Match": {
          "Path": "/api/matching/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "products-route": {
        "Match": {
          "Path": "/api/products/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated",
        "ClusterId": "products-cluster"
      },
      "orders-route": {
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated",
        "ClusterId": "orders-cluster"
      },
      "public-route": {
        "Match": {
          "Path": "/public/products/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "PathRemovePrefix": "/public"
          },
          {
            "PathPrefix": "/api"
          }
        ],
        "ClusterId": "products-cluster"
      }
    },
    "Clusters": {
      "trip-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "matching-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "products-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5104/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5105/"
          }
        }
      }
    }
  },
  "ConnectionStrings": {
    "AuthDb": "Server=localhost;Port=3306;Database=swiftride_auth;User=swiftride;Password=change-me"
  },
  "JwtSettings": {
    "Issuer": "SwiftRide.Gateway",
    "Audience": "SwiftRide.Client",
    "RefreshTokenDays": 7,
    "ExpiryTime": 15,
    "SecretKey": ""
  },
  "AuthDatabase": {
    "EnsureCreated": false
  }
}
