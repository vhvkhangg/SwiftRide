{
  "Routes": [
    {
      "UpstreamPathTemplate": "/api/trips/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "DownstreamPathTemplate": "/api/trips/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5101
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/matching/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST"
      ],
      "DownstreamPathTemplate": "/api/matching/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5102
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/payments/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST"
      ],
      "DownstreamPathTemplate": "/api/payments/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5103
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/products/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "DownstreamPathTemplate": "/api/products/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Port": 5104,
          "Host": "localhost"
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/orders/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "DownstreamPathTemplate": "/api/orders/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Port": 5105,
          "Host": "localhost"
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/public/products/{everything}",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "DownstreamPathTemplate": "/api/products/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Port": 5104,
          "Host": "localhost"
        }
      ],
      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5100",
    "AuthenticationOptions": {
      "AuthenticationProviderKeys": [
        "Bearer"
      ]
    }
  }
}
