@baseUrl = http://localhost:5100
@keycloakUrl = http://localhost:8180
@password = SwiftRide-demo-2026!

### 1. Lấy Token cho Rider
# @name loginRider
POST {{keycloakUrl}}/realms/swiftride/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=swiftride-postman&username=rider.demo@example.com&password={{password}}

### Token Rider lấy tự động từ phản hồi login
@riderToken = {{loginRider.response.body.$.access_token}}

### 2. Lấy Token cho Driver
# @name loginDriver
POST {{keycloakUrl}}/realms/swiftride/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=swiftride-postman&username=driver.demo@example.com&password={{password}}

### Token Driver lấy tự động từ phản hồi login
@driverToken = {{loginDriver.response.body.$.access_token}}

### Health Check (Không cần Auth)
GET {{baseUrl}}/health

### Tính báo giá chuyến đi (Rider)
POST {{baseUrl}}/api/matching/quote
Authorization: Bearer {{riderToken}}
Content-Type: application/json

{
  "distance": 8.5,
  "estimatedTime": 22,
  "rideType": "Car",
  "promoCode": "SWIFTRIDE2026"
}

### Cập nhật vị trí tài xế (Driver)
POST {{baseUrl}}/api/drivers/location
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "latitude": 10.7769,
  "longitude": 106.7009,
  "isAvailable": true
}

### Tìm tài xế xung quanh (Rider)
POST {{baseUrl}}/api/matching/match
Authorization: Bearer {{riderToken}}
Content-Type: application/json

{
  "tripId": "123e4567-e89b-12d3-a456-426614174000",
  "pickupLatitude": 10.7769,
  "pickupLongitude": 106.7009,
  "radiusKm": 5
}
